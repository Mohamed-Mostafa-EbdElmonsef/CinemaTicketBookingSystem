@model MovieFormViewModel
@{ ViewData["Title"] = "إضافة فيلم"; }

<h2 class="mb-4"><i class="bi bi-plus-circle"></i> إضافة فيلم</h2>

<div class="card shadow-sm p-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<MovieStatus>()"></select>
            </div>

            <div class="col-12">
                <label asp-for="Des" class="form-label"></label>
                <textarea asp-for="Des" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Des" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="DateTime" class="form-label"></label>
                <input asp-for="DateTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="DateTime" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                    <option value="">-- اختر --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CinemaId" class="form-label"></label>
                <select asp-for="CinemaId" class="form-select" asp-items="@(new SelectList(Model.Cinemas, "Id", "Name"))">
                    <option value="">-- اختر --</option>
                </select>
                <span asp-validation-for="CinemaId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">الصورة الرئيسية</label>
                <input type="file" name="MainImgFile" class="form-control" accept="image/*" />
            </div>
            <div class="col-md-6">
                <label class="form-label">صور فرعية إضافية (يمكن اختيار أكثر من صورة)</label>
                <input type="file" name="SubImageFiles" class="form-control" accept="image/*" multiple />
            </div>

            <div class="col-12">
                <label class="form-label">الممثلون</label>
                <div class="border rounded p-3" style="max-height:200px; overflow-y:auto;">
                    @if (Model.Actors != null)
                    {
                        @foreach (var actor in Model.Actors)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="SelectedActorIds" value="@actor.Id"
                                       id="actor_@actor.Id"
                                       checked="@(Model.SelectedActorIds.Contains(actor.Id))" />
                                <label class="form-check-label" for="actor_@actor.Id">@actor.Name</label>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-success mt-4"><i class="bi bi-save"></i> حفظ</button>
        <a asp-action="Index" class="btn btn-secondary mt-4">إلغاء</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
