@model Movie
@{ ViewData["Title"] = "تفاصيل الفيلم"; }

<h2 class="mb-4"><i class="bi bi-film"></i> @Model.Name</h2>

<div class="row g-4">
    <div class="col-md-4">
        <img src="@(string.IsNullOrEmpty(Model.MainImg) ? "https://placehold.co/400x600?text=No+Image" : Model.MainImg)" class="img-fluid rounded shadow" />
    </div>
    <div class="col-md-8">
        <table class="table">
            <tr><th>الوصف</th><td>@Model.Des</td></tr>
            <tr><th>السعر</th><td>@Model.Price.ToString("0.00") ج.م</td></tr>
            <tr><th>الحالة</th><td>@Model.Status.GetDisplayName()</td></tr>
            <tr><th>الموعد</th><td>@Model.DateTime.ToString("yyyy/MM/dd hh:mm tt")</td></tr>
            <tr><th>التصنيف</th><td>@Model.Category?.Name</td></tr>
            <tr><th>السينما</th><td>@Model.Cinema?.Name</td></tr>
            <tr>
                <th>الممثلون</th>
                <td>@string.Join("، ", Model.MovieActors.Select(ma => ma.Actor?.Name))</td>
            </tr>
        </table>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> تعديل</a>
        <a class="btn btn-secondary" asp-action="Index">رجوع</a>
    </div>
</div>
