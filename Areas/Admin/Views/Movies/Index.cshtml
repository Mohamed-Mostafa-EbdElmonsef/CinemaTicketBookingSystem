@model List<Movie>
@{ ViewData["Title"] = "الأفلام"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-film"></i> الأفلام</h2>
    <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> إضافة فيلم</a>
</div>

<table class="table table-striped bg-white shadow-sm align-middle">
    <thead>
        <tr>
            <th>الصورة</th><th>الاسم</th><th>التصنيف</th><th>السينما</th><th>السعر</th><th>الحالة</th><th>الموعد</th><th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@(string.IsNullOrEmpty(item.MainImg) ? "https://placehold.co/60x60?text=%20" : item.MainImg)" class="thumb-sm" /></td>
                <td>@item.Name</td>
                <td>@item.Category?.Name</td>
                <td>@item.Cinema?.Name</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>@item.Status.GetDisplayName()</td>
                <td>@item.DateTime.ToString("yyyy/MM/dd hh:mm tt")</td>
                <td>
                    <a class="btn btn-sm btn-info text-white" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
