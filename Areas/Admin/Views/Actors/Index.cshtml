@model List<Actor>
@{ ViewData["Title"] = "الممثلون"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-badge-fill"></i> الممثلون</h2>
    <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-circle"></i> إضافة ممثل</a>
</div>

<table class="table table-striped bg-white shadow-sm align-middle">
    <thead><tr><th>الصورة</th><th>الاسم</th><th>إجراءات</th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@(string.IsNullOrEmpty(item.Img) ? "https://placehold.co/60x60?text=%20" : item.Img)" class="thumb-sm rounded-circle" /></td>
                <td>@item.Name</td>
                <td>
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>
