@model Actor
@{ ViewData["Title"] = "تعديل ممثل"; }

<h2 class="mb-4"><i class="bi bi-pencil"></i> تعديل ممثل</h2>
<div class="card shadow-sm p-4" style="max-width:500px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Img))
        {
            <div class="mb-2"><img src="@Model.Img" class="thumb-sm rounded-circle" /></div>
        }
        <div class="mb-3">
            <label class="form-label">تغيير الصورة (اختياري)</label>
            <input type="file" name="imgFile" class="form-control" accept="image/*" />
        </div>
        <button type="submit" class="btn btn-success">حفظ التعديلات</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
