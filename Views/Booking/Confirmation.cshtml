@model Booking
@{
    ViewData["Title"] = "تم الحجز بنجاح";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm p-4 text-center">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            <h3 class="mt-3">تم تأكيد حجزك بنجاح!</h3>
            <hr />
            <table class="table table-borderless text-start">
                <tr><th>الفيلم:</th><td>@Model.Movie?.Name</td></tr>
                <tr><th>اسم العميل:</th><td>@Model.CustomerName</td></tr>
                <tr><th>رقم الهاتف:</th><td>@Model.Phone</td></tr>
                <tr><th>عدد المقاعد:</th><td>@Model.NumberOfSeats</td></tr>
                <tr><th>الإجمالي:</th><td class="fw-bold text-primary">@Model.TotalPrice.ToString("0.00") ج.م</td></tr>
                <tr><th>رقم الحجز:</th><td>#@Model.Id</td></tr>
            </table>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">العودة للرئيسية</a>
        </div>
    </div>
</div>
